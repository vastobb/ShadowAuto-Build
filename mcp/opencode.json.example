{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "shadowauto": {
        "type": "local",
        "command": ["python3", "/home/flux/ShadowAuto-Build/mcp/mcp_server.py"],
        "environment": {
          "SHADOWAUTO_HOST": "127.0.0.1",
          "SHADOWAUTO_PORT": "43110",
          "SHADOWAUTO_RPC_TIMEOUT": "15"
        },
        "timeout": {
          "startup": 30000,
          "execution": 600000
        }
      }
    }
  }
}
